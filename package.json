{
  "name": "oras-bin-wrapper",
  "version": "1.3.2-beta.0",
  "description": "Node.js wrapper for oras CLI binaries (cross-platform)",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "postinstall": "node postinstall.js",
    "test": "mocha -r ts-node/register test/**/*.ts",
    "test:cjs": "node test/test-cjs.js",
    "test:esm": "node test/test-esm.mjs",
    "download-binaries": "bash update-oras-binaries.sh"
  },
  "files": [
    "dist",
    "lib",
    "postinstall.js"
  ],
  "keywords": [
    "oras",
    "binary",
    "cli",
    "wrapper"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alishah730/oras-bin-wrapper"
  },
  "bugs": {
    "url": "https://github.com/alishah730/oras-bin-wrapper/issues"
  },
  "homepage": "https://github.com/alishah730/oras-bin-wrapper#readme",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/tar": "^7.0.87",
    "@types/unzipper": "^0.10.11",
    "assert": "^2.1.0",
    "mocha": "^11.7.5",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "tar": "^7.5.15",
    "unzipper": "^0.12.3"
  }
}
